        {
          "name": "Création (POST)",
          "item": [
            {
              "name": "Créer un produit",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Test 1 : le statut est 200 ou 201\r\npm.test(\"Statut de création valide\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r\n});\r\n\r\n// Extraire l'ID du produit créé et le stocker dans l'environnement\r\nvar jsonData = pm.response.json();\r\npm.environment.set(\"createdProductId\", jsonData.id);\r\nconsole.log(\"ID du produit créé : \" + jsonData.id);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"title\": \"Casque Audio Sans Fil\",\r\n  \"price\": 129.99,\r\n  \"category\": \"audio\",\r\n  \"stock\": 25\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/users/add",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "users",
                    "add"
                  ]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Modification (PUT/PATCH)",
          "item": [
            {
              "name": "Modifier un produit",
              "request": {
                "method": "PATCH",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"price\": 139.99\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/products/{{productId}}",

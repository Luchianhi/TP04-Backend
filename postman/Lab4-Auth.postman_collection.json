      "name": "LAB1 - Gestion Produits REST",
      "item": [
        {
          "name": "Lecture (GET)",
          "item": [
            {
              "name": "Produit par ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/products/category/smartphones",
                  "host": [
                    "{{baseUrl}}"
